# ==============================================================================
# Environment Configuration Template
# “DHRUTI — The Living Intelligence Universe”
#
# Copy this file to '.env.local' and fill in your actual credentials.
# NEVER commit '.env.local' or paste real secrets into public repositories.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. VISITOR COUNTER (Firebase Realtime Database or Counter API)
# ------------------------------------------------------------------------------
# Create a free Firebase project at https://console.firebase.google.com/
# Enable "Realtime Database" (in test/locked rules as documented in README)
# Copy your Project ID and Database URL here:
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com
VITE_FIREBASE_API_KEY=your-firebase-api-key

# ------------------------------------------------------------------------------
# 2. SECURE CONTACT FORM BACKEND
# ------------------------------------------------------------------------------
# Secure form endpoints route user messages directly to dhrutiviradiya333@gmail.com
# without exposing SMTP passwords or private mail credentials in the browser.
#
# Recommended options (Free & Secure):
# Option A (Formspree): Create a form at https://formspree.io/ -> set target to dhrutiviradiya333@gmail.com
# VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-formspree-id
#
# Option B (Web3Forms): Get access key at https://web3forms.com/ -> target dhrutiviradiya333@gmail.com
# VITE_CONTACT_FORM_ENDPOINT=https://api.web3forms.com/submit
# VITE_WEB3FORMS_ACCESS_KEY=your-web3forms-access-key
#
VITE_CONTACT_FORM_ENDPOINT=https://formspree.io/f/your-form-id
VITE_WEB3FORMS_ACCESS_KEY=
